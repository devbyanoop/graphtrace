<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  body { font-family: system-ui, sans-serif; margin: 2rem; color: #1a1a1a; background: #fff; }
  h1 { margin-bottom: 0.5rem; }
  .summary { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.5rem; }
  .summary div { padding: 0.4rem 0.9rem; border-radius: 6px; background: #f1f1f1; font-size: 0.95em; }
  .passed { color: #146c2e; }
  .failed { color: #b42318; }
  .errored { color: #b45309; }
  .test { border: 1px solid #ddd; border-radius: 8px; margin-bottom: 1rem; padding: 1rem 1.25rem; }
  .test.failed { border-color: #f3b3ab; background: #fff5f4; }
  .test.error { border-color: #fcd9a0; background: #fffaf0; }
  .test h2 { margin: 0 0 0.5rem 0; font-size: 1.05em; }
  .verdict.pass { color: #146c2e; font-weight: 600; }
  .verdict.fail { color: #b42318; font-weight: 600; }
  .step { margin: 0.35rem 0 0.35rem 0.5rem; padding: 0.4rem 0.7rem; border-left: 3px solid #ccc; }
  .call { margin: 0.25rem 0 0.25rem 1rem; font-size: 0.9em; color: #333; }
  pre { white-space: pre-wrap; word-break: break-word; background: #f7f7f7; padding: 0.5rem; border-radius: 4px; margin: 0.25rem 0; }

  /* Executive summary -- for a QA lead / manager / consultant / auditor
     deciding go/no-go, not for an engineer debugging a trajectory. */
  .exec-summary { border: 1px solid #ddd; border-radius: 10px; padding: 1.25rem 1.5rem; margin-bottom: 2rem; }
  .release-verdict { font-size: 1.3em; font-weight: 700; padding: 0.6rem 1rem; border-radius: 8px; margin-bottom: 1rem; display: inline-block; }
  .release-verdict.ready { background: #e7f6ec; color: #146c2e; border: 1px solid #a9dfba; }
  .release-verdict.not-ready { background: #fde8e6; color: #92251a; border: 1px solid #f3b3ab; }
  .blocking-list { list-style: none; padding: 0; margin: 0.5rem 0 1rem 0; }
  .blocking-list li { padding: 0.5rem 0.75rem; margin-bottom: 0.4rem; border-radius: 6px; background: #fff5f4; border-left: 4px solid #b42318; }
  .blocking-list li.severity-critical { border-left-color: #92251a; background: #fde8e6; }
  .blocking-list li.severity-high { border-left-color: #b45309; background: #fff7ed; }
  .blocking-list li.severity-normal { border-left-color: #b42318; }
  .blocking-list li.severity-low { border-left-color: #9ca3af; background: #f9fafb; }
  .severity-badge { display: inline-block; font-size: 0.75em; font-weight: 700; text-transform: uppercase; padding: 0.1rem 0.5rem; border-radius: 4px; margin-right: 0.5rem; color: #fff; }
  .severity-badge.severity-critical { background: #92251a; }
  .severity-badge.severity-high { background: #b45309; }
  .severity-badge.severity-normal { background: #4b5563; }
  .severity-badge.severity-low { background: #9ca3af; }
  .category-badge { display: inline-block; font-size: 0.8em; background: #eef2ff; color: #3730a3; padding: 0.1rem 0.5rem; border-radius: 4px; margin-left: 0.5rem; }
  .coverage-list { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.5rem 0; }
  .coverage-list span { background: #f1f1f1; padding: 0.3rem 0.7rem; border-radius: 6px; font-size: 0.9em; }
  .no-coverage { color: #6b7280; font-style: italic; font-size: 0.9em; }
  .jump-link { font-size: 0.85em; }
  details.technical-detail { margin-top: 2rem; }
  details.technical-detail > summary { cursor: pointer; font-weight: 600; font-size: 1.1em; margin-bottom: 1rem; }
</style>
</head>
<body>
<h1>{{ title }}</h1>

<div class="exec-summary">
  <div class="release-verdict {{ 'ready' if exec_summary.ready else 'not-ready' }}">
    {% if exec_summary.ready %}READY{% else %}NOT READY &mdash; {{ exec_summary.blocking|length }} blocking issue{{ "s" if exec_summary.blocking|length != 1 else "" }}{% endif %}
  </div>

  {% if exec_summary.blocking %}
  <h3>Blocking issues</h3>
  <ul class="blocking-list">
    {% for result in exec_summary.blocking %}
    <li class="severity-{{ result.severity }}">
      <span class="severity-badge severity-{{ result.severity }}">{{ result.severity }}</span>
      {{ result.description or result.test_id }}
      {% if result.category %}<span class="category-badge">{{ result.category }}</span>{% endif %}
      &mdash; <a class="jump-link" href="#detail-{{ results.index(result) }}">see technical detail</a>
    </li>
    {% endfor %}
  </ul>
  {% endif %}

  <h3>Coverage</h3>
  {% if exec_summary.has_categories %}
  <div class="coverage-list">
    {% for category, count in exec_summary.categories.items() %}
    <span>{{ category }} ({{ count }})</span>
    {% endfor %}
  </div>
  {% else %}
  <p class="no-coverage">No scenario categories were tagged on any test (see <code>@pytest.mark.graphtrace(category=...)</code> in the Report &amp; CI guide) &mdash; coverage breakdown unavailable.</p>
  {% endif %}
</div>

<div class="summary">
  <div>{{ summary.total }} tests</div>
  <div class="passed">{{ summary.passed }} passed</div>
  <div class="failed">{{ summary.failed }} failed</div>
  <div class="errored">{{ summary.errored }} errored</div>
  <div>${{ "%.4f"|format(summary.total_cost_usd) }} total cost</div>
  <div>{{ "%.2f"|format(summary.total_latency_s) }}s total latency</div>
</div>

<details class="technical-detail">
<summary>Technical detail (per-test trajectories, for debugging a failure)</summary>
{% for result in results %}
<div class="test {{ result.outcome }}" id="detail-{{ loop.index0 }}">
  <h2>{{ result.test_id }} &mdash; <span class="verdict {{ 'pass' if result.outcome == 'passed' else 'fail' }}">{{ result.outcome }}</span></h2>

  {% if result.description %}
  <p><em>{{ result.description }}</em>{% if result.category %} <span class="category-badge">{{ result.category }}</span>{% endif %}</p>
  {% endif %}

  {% if result.error_message %}
  <pre class="error">{{ result.error_message }}</pre>
  {% endif %}

  {% if result.judge_verdicts %}
  <h3>Judge verdicts</h3>
  <ul>
    {% for verdict in result.judge_verdicts %}
    <li>
      <span class="verdict {{ 'pass' if verdict.passed else 'fail' }}">{{ verdict.rubric_id }}: {{ 'pass' if verdict.passed else 'fail' }}</span>
      <ul>
        {% for criterion_id, criterion in verdict.criteria.items() %}
        <li>{{ criterion_id }}: {{ criterion }}</li>
        {% endfor %}
      </ul>
    </li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if result.trajectory %}
  <p>
    cost: ${{ "%.4f"|format(result.trajectory.cost_usd) }}
    &middot; latency: {{ "%.2f"|format(result.trajectory.latency_s) }}s
    &middot; tokens: {{ result.trajectory.tokens_total }}
    {% if result.trajectory.interrupted %}&middot; interrupted{% endif %}
  </p>

  <h3>Trajectory</h3>
  {% for step in result.trajectory.steps %}
  <div class="step">
    <strong>[{{ step.index }}] {{ step.node }}</strong> ({{ step.kind }}, {{ "%.2f"|format(step.latency_s) }}s)
    {% for call in step.llm_calls %}
    <div class="call">
      llm &middot; {{ call.model }} &middot; {{ call.prompt_tokens }}+{{ call.completion_tokens }} tokens &middot; ${{ "%.4f"|format(call.cost_usd) }}
      <pre>{{ call.output }}</pre>
    </div>
    {% endfor %}
    {% for call in step.tool_calls %}
    <div class="call">
      tool &middot; {{ call.name }}({{ call.args }})
      {% if call.error %}
      <span class="verdict fail">error: {{ call.error }}</span>
      {% else %}
      &rarr; <pre>{{ call.result }}</pre>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endfor %}

  {% if result.trajectory.final_message %}
  <h3>Final message</h3>
  <pre>{{ result.trajectory.final_message }}</pre>
  {% endif %}
  {% endif %}
</div>
{% endfor %}
</details>
</body>
</html>
